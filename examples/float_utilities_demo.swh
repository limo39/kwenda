andika("8. TYPE CHECKING")
andika("==================================================")
andika("Validating number types:")
andika("")

namba test1 = 5.0
namba test2 = 5.5
andika("Is 5.0 a whole number?", ni_kamili(test1))
andika("Is 5.5 a whole number?", ni_kamili(test2))
andika("Is 5.0 finite?", ni_usawa(test1))
andika("Is 5.0 NaN?", ni_sio_namba(test1))

andika("")
andika("==================================================")
andika("9. PRACTICAL EXAMPLE: TEMPERATURE CONVERTER")
andika("==================================================")
andika("Converting with rounding:")
andika("")

namba celsius = 25.7
namba fahrenheit = celsius * 9 / 5 + 32
andika("Temperature: 25.7 C")
andika("In Fahrenheit (exact):", fahrenheit)
andika("In Fahrenheit (rounded):", pindika(fahrenheit))

andika("")
andika("==================================================")
andika("10. PRACTICAL EXAMPLE: PROGRESS BAR")
andika("==================================================")
andika("Calculating completion percentage:")
andika("")

namba current = 73
namba total = 150
namba percent = (current / total) * 100
namba clamped = upeo(percent, 0, 100)

andika("Progress: 73 / 150")
andika("Percentage (exact):", percent)
andika("Percentage (clamped):", clamped)
andika("Percentage (rounded):", pindika(clamped))

