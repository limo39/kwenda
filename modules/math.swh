# Math module - Moduli ya hesabu
# Standard library for mathematical operations

# ==================== MATHEMATICAL CONSTANTS ====================
# These are fundamental mathematical constants useful in calculations

# Primary constants
namba PI = 3.14159265359         # Pi - ratio of circle's circumference to diameter
namba E = 2.71828182846          # Euler's number - base of natural logarithm

# Related PI constants
namba PI_2 = 1.57079632679        # PI/2 - quarter rotation (90 degrees)
namba PI_4 = 0.78539816339        # PI/4 - eighth rotation (45 degrees)
namba TAU = 6.28318530718         # TAU (2*PI) - full rotation (360 degrees)
namba DEG_TO_RAD = 0.01745329249  # Conversion factor: degrees to radians (PI/180)
namba RAD_TO_DEG = 57.2957795131  # Conversion factor: radians to degrees (180/PI)

# Root constants
namba SQRT_2 = 1.41421356237      # Square root of 2
namba SQRT_3 = 1.73205080757      # Square root of 3
namba SQRT_5 = 2.23606797750      # Square root of 5 (related to golden ratio)

# Golden ratio and related
namba PHI = 1.61803398875         # Golden ratio (Phi)
namba LN_2 = 0.69314718056        # Natural logarithm of 2
namba LN_10 = 2.30258509299       # Natural logarithm of 10

# Physical and mathematical constants
namba EULER_GAMMA = 0.57721566490 # Euler-Mascheroni constant (gamma)

# ==================== END CONSTANTS ====================

# Basic arithmetic
kazi ongeza(namba a, namba b) {
    rudisha a + b
}

kazi toa(namba a, namba b) {
    rudisha a - b
}

kazi zidisha(namba a, namba b) {
    rudisha a * b
}

kazi gawanya(namba a, namba b) {
    kama b == 0 {
        tupa "Haiwezekani kugawanya na sifuri (Cannot divide by zero)"
    }
    rudisha a / b
}

# Advanced operations
kazi kiwango(namba x) {
    kama x < 0 {
        rudisha 0 - x
    }
    rudisha x
}

kazi nguvu(namba msingi, namba exponent) {
    # Power function: msingi^exponent
    kama exponent == 0 {
        rudisha 1
    }
    namba jibu = 1
    namba i = 0
    wakati i < exponent {
        jibu = jibu * msingi
        i = i + 1
    }
    rudisha jibu
}

kazi mraba(namba x) {
    rudisha x * x
}

kazi mchemraba(namba x) {
    rudisha x * x * x
}

# Comparison functions
kazi ndogo(namba a, namba b) {
    kama a < b {
        rudisha a
    }
    rudisha b
}

kazi kubwa(namba a, namba b) {
    kama a > b {
        rudisha a
    }
    rudisha b
}

# Number properties
kazi ni_sawa(namba a, namba b) {
    rudisha a == b
}

kazi ni_chanya(namba x) {
    rudisha x > 0
}

kazi ni_hasi(namba x) {
    rudisha x < 0
}

kazi ni_sifuri(namba x) {
    rudisha x == 0
}

# Modulo operation
kazi salio(namba a, namba b) {
    kama b == 0 {
        tupa "Haiwezekani kuhesabu salio na sifuri (Cannot calculate modulo with zero)"
    }
    namba jibu = a
    wakati jibu >= b {
        jibu = jibu - b
    }
    rudisha jibu
}

# Check if even or odd
kazi ni_shufwa(namba x) {
    namba s = salio(x, 2)
    rudisha s == 0
}

kazi ni_witiri(namba x) {
    namba s = salio(x, 2)
    rudisha s != 0
}