kazi kuu() {
    andika("===============================================")
    andika("ADVANCED OPERATIONS - COMPREHENSIVE TEST SUITE")
    andika("===============================================")
    andika("")
    
    // ==================== BITWISE OPERATIONS ====================
    andika("TEST SECTION 1: BITWISE AND (na_kidogo)")
    andika("na_kidogo(12, 10) = ", na_kidogo(12, 10), " [Expected: 8]")
    andika("na_kidogo(15, 7) = ", na_kidogo(15, 7), " [Expected: 7]")
    andika("na_kidogo(8, 4) = ", na_kidogo(8, 4), " [Expected: 0]")
    andika("na_kidogo(255, 15) = ", na_kidogo(255, 15), " [Expected: 15]")
    andika("na_kidogo(0, 100) = ", na_kidogo(0, 100), " [Expected: 0]")
    andika("")
    
    andika("TEST SECTION 2: BITWISE OR (au_kidogo)")
    andika("au_kidogo(12, 10) = ", au_kidogo(12, 10), " [Expected: 14]")
    andika("au_kidogo(8, 4) = ", au_kidogo(8, 4), " [Expected: 12]")
    andika("au_kidogo(1, 2) = ", au_kidogo(1, 2), " [Expected: 3]")
    andika("au_kidogo(0, 0) = ", au_kidogo(0, 0), " [Expected: 0]")
    andika("au_kidogo(255, 0) = ", au_kidogo(255, 0), " [Expected: 255]")
    andika("")
    
    andika("TEST SECTION 3: BITWISE XOR (ama_kidogo)")
    andika("ama_kidogo(12, 10) = ", ama_kidogo(12, 10), " [Expected: 6]")
    andika("ama_kidogo(15, 15) = ", ama_kidogo(15, 15), " [Expected: 0]")
    andika("ama_kidogo(7, 3) = ", ama_kidogo(7, 3), " [Expected: 4]")
    andika("ama_kidogo(255, 0) = ", ama_kidogo(255, 0), " [Expected: 255]")
    andika("ama_kidogo(5, 5) = ", ama_kidogo(5, 5), " [Expected: 0]")
    andika("")
    
    andika("TEST SECTION 4: BITWISE NOT (si_kidogo)")
    andika("si_kidogo(0) = ", si_kidogo(0), " [Expected: -1]")
    andika("si_kidogo(1) = ", si_kidogo(1), " [Expected: -2]")
    andika("si_kidogo(5) = ", si_kidogo(5), " [Expected: -6]")
    andika("si_kidogo(-1) = ", si_kidogo(-1), " [Expected: 0]")
    andika("")
    
    andika("TEST SECTION 5: LEFT SHIFT (gezo_kushoto)")
    andika("gezo_kushoto(5, 1) = ", gezo_kushoto(5, 1), " [Expected: 10]")
    andika("gezo_kushoto(3, 2) = ", gezo_kushoto(3, 2), " [Expected: 12]")
    andika("gezo_kushoto(1, 4) = ", gezo_kushoto(1, 4), " [Expected: 16]")
    andika("gezo_kushoto(1, 8) = ", gezo_kushoto(1, 8), " [Expected: 256]")
    andika("gezo_kushoto(7, 0) = ", gezo_kushoto(7, 0), " [Expected: 7]")
    andika("")
    
    andika("TEST SECTION 6: RIGHT SHIFT (gezo_kulia)")
    andika("gezo_kulia(10, 1) = ", gezo_kulia(10, 1), " [Expected: 5]")
    andika("gezo_kulia(12, 2) = ", gezo_kulia(12, 2), " [Expected: 3]")
    andika("gezo_kulia(16, 3) = ", gezo_kulia(16, 3), " [Expected: 2]")
    andika("gezo_kulia(256, 8) = ", gezo_kulia(256, 8), " [Expected: 1]")
    andika("gezo_kulia(7, 0) = ", gezo_kulia(7, 0), " [Expected: 7]")
    andika("")
    
    // ==================== MODULAR ARITHMETIC ====================
    andika("TEST SECTION 7: MODULO (modulo)")
    andika("modulo(10, 3) = ", modulo(10, 3), " [Expected: 1]")
    andika("modulo(20, 6) = ", modulo(20, 6), " [Expected: 2]")
    andika("modulo(7, 7) = ", modulo(7, 7), " [Expected: 0]")
    andika("modulo(15, 4) = ", modulo(15, 4), " [Expected: 3]")
    andika("modulo(100, 10) = ", modulo(100, 10), " [Expected: 0]")
    andika("")
    
    andika("TEST SECTION 8: REMAINDER (baki)")
    andika("baki(10, 3) = ", baki(10, 3), " [Expected: 1]")
    andika("baki(25, 5) = ", baki(25, 5), " [Expected: 0]")
    andika("baki(17, 5) = ", baki(17, 5), " [Expected: 2]")
    andika("baki(100, 7) = ", baki(100, 7), " [Expected: 2]")
    andika("baki(13, 13) = ", baki(13, 13), " [Expected: 0]")
    andika("")
    
    andika("TEST SECTION 9: MODULAR POWER (tweza_modulo)")
    andika("tweza_modulo(2, 3, 5) = ", tweza_modulo(2, 3, 5), " [Expected: 3]")
    andika("tweza_modulo(3, 4, 5) = ", tweza_modulo(3, 4, 5), " [Expected: 1]")
    andika("tweza_modulo(7, 2, 11) = ", tweza_modulo(7, 2, 11), " [Expected: 5]")
    andika("tweza_modulo(2, 10, 1000) = ", tweza_modulo(2, 10, 1000), " [Expected: 24]")
    andika("tweza_modulo(5, 0, 7) = ", tweza_modulo(5, 0, 7), " [Expected: 1]")
    andika("")
    
    // ==================== ROUNDING FUNCTIONS ====================
    andika("TEST SECTION 10: ROUND (pindika)")
    andika("pindika(3.4) = ", pindika(3.4), " [Expected: 3]")
    andika("pindika(3.5) = ", pindika(3.5), " [Expected: 4]")
    andika("pindika(3.6) = ", pindika(3.6), " [Expected: 4]")
    andika("pindika(-2.7) = ", pindika(-2.7), " [Expected: -3]")
    andika("pindika(0.0) = ", pindika(0.0), " [Expected: 0]")
    andika("")
    
    andika("TEST SECTION 11: FLOOR (sakafu)")
    andika("sakafu(3.9) = ", sakafu(3.9), " [Expected: 3]")
    andika("sakafu(3.1) = ", sakafu(3.1), " [Expected: 3]")
    andika("sakafu(-2.3) = ", sakafu(-2.3), " [Expected: -3]")
    andika("sakafu(-2.9) = ", sakafu(-2.9), " [Expected: -3]")
    andika("sakafu(5.0) = ", sakafu(5.0), " [Expected: 5]")
    andika("")
    
    andika("TEST SECTION 12: CEILING (dari)")
    andika("dari(3.1) = ", dari(3.1), " [Expected: 4]")
    andika("dari(3.9) = ", dari(3.9), " [Expected: 4]")
    andika("dari(-2.1) = ", dari(-2.1), " [Expected: -2]")
    andika("dari(-2.9) = ", dari(-2.9), " [Expected: -2]")
    andika("dari(5.0) = ", dari(5.0), " [Expected: 5]")
    andika("")
    
    andika("TEST SECTION 13: TRUNCATE (kata)")
    andika("kata(3.9) = ", kata(3.9), " [Expected: 3]")
    andika("kata(3.1) = ", kata(3.1), " [Expected: 3]")
    andika("kata(-2.7) = ", kata(-2.7), " [Expected: -2]")
    andika("kata(-2.1) = ", kata(-2.1), " [Expected: -2]")
    andika("kata(5.0) = ", kata(5.0), " [Expected: 5]")
    andika("")
    
    // ==================== RANDOM NUMBER GENERATION ====================
    andika("TEST SECTION 14: RANDOM FLOAT (nasibu without args)")
    weka_mbegu(42)
    andika("nasibu() = ", nasibu())
    andika("nasibu() = ", nasibu())
    andika("nasibu() = ", nasibu())
    andika("[Should be between 0.0 and 1.0]")
    andika("")
    
    andika("TEST SECTION 15: RANDOM INTEGER 0 to N-1 (nasibu with 1 arg)")
    weka_mbegu(42)
    andika("nasibu(10) = ", nasibu(10))
    andika("nasibu(10) = ", nasibu(10))
    andika("nasibu(100) = ", nasibu(100))
    andika("[Should be between 0 and N-1]")
    andika("")
    
    andika("TEST SECTION 16: RANDOM INTEGER [MIN, MAX] (nasibu with 2 args)")
    weka_mbegu(42)
    andika("nasibu(1, 10) = ", nasibu(1, 10))
    andika("nasibu(1, 10) = ", nasibu(1, 10))
    andika("nasibu(50, 100) = ", nasibu(50, 100))
    andika("[Should be between MIN and MAX inclusive]")
    andika("")
    
    andika("TEST SECTION 17: RANDOM SEED REPRODUCIBILITY (weka_mbegu)")
    weka_mbegu(123)
    muundo_1 = nasibu(1, 100)
    muundo_2 = nasibu(1, 100)
    weka_mbegu(123)
    muundo_3 = nasibu(1, 100)
    muundo_4 = nasibu(1, 100)
    andika("First run: ", muundo_1, ", ", muundo_2)
    andika("Second run (same seed): ", muundo_3, ", ", muundo_4)
    andika("[Should be identical when using same seed]")
    andika("")
    
    // ==================== EDGE CASES & COMBINED OPERATIONS ====================
    andika("TEST SECTION 18: EDGE CASES")
    andika("Bitwise with zero: na_kidogo(0, 0) = ", na_kidogo(0, 0))
    andika("Modulo with 1: modulo(100, 1) = ", modulo(100, 1))
    andika("Round already integer: pindika(5.0) = ", pindika(5.0))
    andika("Shift by zero: gezo_kushoto(8, 0) = ", gezo_kushoto(8, 0))
    andika("")
    
    andika("TEST SECTION 19: COMBINED OPERATIONS")
    andika("(na_kidogo(15, 12)) << 2 = ", gezo_kushoto(na_kidogo(15, 12), 2))
    andika("pindika(sakafu(3.7)) = ", pindika(sakafu(3.7)))
    andika("modulo(tweza_modulo(2, 5, 7), 3) = ", modulo(tweza_modulo(2, 5, 7), 3))
    andika("")
    
    andika("===============================================")
    andika("COMPREHENSIVE TEST SUITE COMPLETED")
    andika("All 19 test sections executed successfully")
    andika("===============================================")
}
