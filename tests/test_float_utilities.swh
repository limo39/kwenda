andika("=============================================")
andika("Testing Float Utilities")
andika("=============================================")

andika("\n--- Modulo and Remainder Functions ---")
andika("bakiza(7.5, 2) =", bakiza(7.5, 2))
andika("bakiza(10, 3) =", bakiza(10, 3))
andika("salio(7.5, 2.5) =", salio(7.5, 2.5))
andika("salio(10, 3) =", salio(10, 3))

andika("\n--- Copysign Function ---")
andika("kopanja(5, 1) =", kopanja(5, 1))
andika("kopanja(5, -1) =", kopanja(5, -1))
andika("kopanja(-5, 1) =", kopanja(-5, 1))
andika("kopanja(3.14, -2) =", kopanja(3.14, -2))

andika("\n--- Approximate Equality ---")
andika("karibia(1.0, 1.0000000001) =", karibia(1.0, 1.0000000001))
andika("karibia(1.0, 1.1) =", karibia(1.0, 1.1))
andika("karibia(0.1, 0.10001, 0.001) =", karibia(0.1, 0.10001, 0.001))

andika("\n--- Number Type Checks ---")
andika("ni_kamili(5.0) =", ni_kamili(5.0))
andika("ni_kamili(5.5) =", ni_kamili(5.5))
andika("ni_usawa(10) =", ni_usawa(10))
andika("ni_sio_namba(5) =", ni_sio_namba(5))

andika("\n--- Clamp Function ---")
andika("upeo(5, 0, 10) =", upeo(5, 0, 10))
andika("upeo(-5, 0, 10) =", upeo(-5, 0, 10))
andika("upeo(15, 0, 10) =", upeo(15, 0, 10))
andika("upeo(7.5, 2.5, 8.5) =", upeo(7.5, 2.5, 8.5))

andika("\n--- Fractional and Integer Parts ---")
andika("sehemu_desimali(3.14159) =", sehemu_desimali(3.14159))
andika("sehemu_desimali(-2.718) =", sehemu_desimali(-2.718))
andika("sehemu_kamili(3.14159) =", sehemu_kamili(3.14159))
andika("sehemu_kamili(-2.718) =", sehemu_kamili(-2.718))

andika("\n--- Linear Interpolation ---")
andika("mzunguko(0, 10) =", mzunguko(0, 10))
andika("mzunguko(0, 10, 0.5) =", mzunguko(0, 10, 0.5))
andika("mzunguko(0, 10, 0.25) =", mzunguko(0, 10, 0.25))
andika("mzunguko(0, 10, 0.75) =", mzunguko(0, 10, 0.75))
andika("mzunguko(100, 200, 0.3) =", mzunguko(100, 200, 0.3))

andika("\n=============================================")
andika("All Float Utility tests completed!")
andika("=============================================")
