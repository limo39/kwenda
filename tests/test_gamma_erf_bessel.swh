andika("=============================================")
andika("Testing Advanced Special Functions")
andika("=============================================")

andika("\n--- Gamma Function ---")
andika("gamma(1) =", gamma(1))
andika("gamma(2) =", gamma(2))
andika("gamma(5) =", gamma(5))
andika("gamma(0.5) ≈", gamma(0.5))

andika("\n--- Error Function (erf) ---")
andika("erf(0) =", erf(0))
andika("erf(0.5) ≈", erf(0.5))
andika("erf(1) ≈", erf(1))
andika("erf(2) ≈", erf(2))

andika("\n--- Complementary Error Function (erfc) ---")
andika("erfc(0) =", erfc(0))
andika("erfc(0.5) ≈", erfc(0.5))
andika("erfc(1) ≈", erfc(1))
andika("erfc(2) ≈", erfc(2))

andika("\n--- Bessel J0 Function ---")
andika("j0(0) =", j0(0))
andika("j0(0.5) ≈", j0(0.5))
andika("j0(1) ≈", j0(1))
andika("j0(2) ≈", j0(2))

andika("\n--- Bessel J1 Function ---")
andika("j1(0) =", j1(0))
andika("j1(0.5) ≈", j1(0.5))
andika("j1(1) ≈", j1(1))
andika("j1(2) ≈", j1(2))

andika("\n--- Bessel Y0 Function ---")
andika("y0(0.5) ≈", y0(0.5))
andika("y0(1) ≈", y0(1))
andika("y0(2) ≈", y0(2))
andika("y0(3) ≈", y0(3))

andika("\n--- Bessel Y1 Function ---")
andika("y1(0.5) ≈", y1(0.5))
andika("y1(1) ≈", y1(1))
andika("y1(2) ≈", y1(2))
andika("y1(3) ≈", y1(3))

andika("\n=============================================")
andika("All Advanced Special Function tests completed!")
andika("=============================================")
